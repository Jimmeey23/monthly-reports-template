<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Studio Performance Reports</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+Pro:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="upload-page">
  <div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <main class="container upload-shell">
    <div class="upload-hero">
      <span class="eyebrow">Studio Pulse</span>
      <h1>Performance Report <span class="accent">Generator</span></h1>
      <p class="subtitle">Drop your 7 CSV exports below. We'll analyze them and auto-generate a studio &amp; month performance report.</p>
      
      <div style="margin-top:24px; display:flex; gap:8px; justify-content:center; align-items:center;">
        <input type="text" id="join-code" placeholder="6-digit code" maxlength="6" style="padding:10px; border-radius:8px; border:1px solid var(--border); background:var(--bg-card); color:var(--text); font-family:var(--font-mono); font-size:16px; text-align:center; width:140px; letter-spacing:2px;" />
        <button type="button" class="btn btn-secondary" onclick="const code = document.getElementById('join-code').value.trim(); if(code.length === 6) window.location.href = '/join/' + code;">Join Session</button>
      </div>
    </div>

    <% if (error) { %>
      <div class="error" id="error-box" role="alert"><%= error %></div>
    <% } else { %>
      <div class="error" id="error-box" role="alert" style="display:none;"></div>
    <% } %>

    <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data" novalidate>
      <div class="dropzones" id="dropzones">
        <% const icons = { sales: '💳', sessions: '🗓️', checkins: '✅', leads: '📞', new: '✨', lapsed: '📉', active: '👥' };
           slots.forEach(function(slot, i) { %>
          <label class="dropzone" data-field="<%= slot.field %>" style="--i: <%= i %>" tabindex="0">
            <div class="dz-icon"><%= icons[slot.field] || '📄' %></div>
            <div class="dz-body">
              <span class="dz-label"><%= slot.label %></span>
              <span class="dz-file">CSV file &middot; drag or click</span>
            </div>
            <div class="dz-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <input type="file" name="<%= slot.field %>" accept=".csv" required />
          </label>
        <% }) %>
      </div>

      <button type="submit" id="submit-btn" class="btn btn-primary" disabled>
        <span class="btn-label">Upload &amp; Analyze</span>
        <span class="btn-count"><span id="filled-count">0</span>/<%= slots.length %></span>
      </button>
    </form>
  </main>

  <div id="loading-overlay" class="loading-overlay" hidden>
    <div class="loading-card">
      <div class="spinner"></div>
      <div class="loading-title" id="loading-title">Analyzing your data&hellip;</div>
      <div class="loading-sub" id="loading-sub">Preparing CSVs and detecting studios &amp; months.</div>
      <div class="loading-bar"><div class="loading-bar-fill" id="loading-bar-fill" style="width: 0%;"></div></div>
    </div>
  </div>

  <script>
    const form = document.getElementById('upload-form');
    const submitBtn = document.getElementById('submit-btn');
    const filledCountEl = document.getElementById('filled-count');
    const dropzones = Array.from(document.querySelectorAll('.dropzone'));
    const errorBox = document.getElementById('error-box');
    const overlay = document.getElementById('loading-overlay');
    const loadingTitle = document.getElementById('loading-title');
    const loadingSub = document.getElementById('loading-sub');
    const loadingBarFill = document.getElementById('loading-bar-fill');
    const total = dropzones.length;

    function truncate(name, max) {
      if (name.length <= max) return name;
      return name.slice(0, max - 1) + '…';
    }

    function updateZone(zone) {
      const input = zone.querySelector('input[type=file]');
      const fileEl = zone.querySelector('.dz-file');
      if (input.files && input.files[0]) {
        zone.classList.add('filled');
        fileEl.textContent = truncate(input.files[0].name, 28);
      } else {
        zone.classList.remove('filled');
        fileEl.textContent = 'CSV file · drag or click';
      }
      refreshCount();
    }

    function refreshCount() {
      const filled = dropzones.filter((z) => z.classList.contains('filled')).length;
      filledCountEl.textContent = filled;
      submitBtn.disabled = filled < total;
    }

    dropzones.forEach((zone) => {
      const input = zone.querySelector('input[type=file]');
      input.addEventListener('change', () => updateZone(zone));

      zone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
      });

      ['dragenter', 'dragover'].forEach((evt) =>
        zone.addEventListener(evt, (e) => {
          e.preventDefault();
          zone.classList.add('drag-over');
        })
      );
      ['dragleave', 'dragend', 'drop'].forEach((evt) =>
        zone.addEventListener(evt, (e) => {
          e.preventDefault();
          zone.classList.remove('drag-over');
        })
      );
      zone.addEventListener('drop', (e) => {
        const file = e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) {
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          updateZone(zone);
        }
      });
    });

    async function uploadFileInChunks(sessionId, slotField, file, onProgress) {
      const CHUNK_SIZE = 1.5 * 1024 * 1024; // 1.5 MB chunk size to stay safely under Vercel's 4.5 MB limit
      const totalChunks = Math.ceil(file.size / CHUNK_SIZE);

      for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
        const start = chunkIndex * CHUNK_SIZE;
        const end = Math.min(file.size, start + CHUNK_SIZE);
        const blobChunk = file.slice(start, end);

        const formData = new FormData();
        formData.append('sessionId', sessionId);
        formData.append('slot', slotField);
        formData.append('chunkIndex', chunkIndex);
        formData.append('totalChunks', totalChunks);
        formData.append('chunk', blobChunk, `${slotField}_part_${chunkIndex}.csv`);

        const res = await fetch('/upload-chunk', {
          method: 'POST',
          body: formData,
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Upload failed for ${slotField} (part ${chunkIndex + 1}/${totalChunks})`);
        }

        if (onProgress) {
          onProgress(chunkIndex + 1, totalChunks);
        }
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      overlay.hidden = false;
      errorBox.style.display = 'none';

      const sessionId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : 'session_' + Date.now();

      try {
        for (let i = 0; i < dropzones.length; i++) {
          const zone = dropzones[i];
          const field = zone.dataset.field;
          const input = zone.querySelector('input[type=file]');
          const rawFile = input.files[0];

          await uploadFileInChunks(sessionId, field, rawFile, (chunkIdx, totalChunks) => {
            const filePct = chunkIdx / totalChunks;
            const overallPct = Math.round(((i + filePct) / (dropzones.length + 1)) * 100);
            loadingBarFill.style.width = overallPct + '%';
            loadingTitle.textContent = `Uploading file ${i + 1} of ${dropzones.length}: ${truncate(rawFile.name, 22)}`;
            loadingSub.textContent = `Uploading chunk ${chunkIdx} of ${totalChunks} (${(rawFile.size / (1024 * 1024)).toFixed(1)} MB total full file).`;
          });
        }

        loadingBarFill.style.width = '90%';
        loadingTitle.textContent = 'Running performance analysis on full dataset…';
        loadingSub.textContent = 'Aggregating revenue, conversion funnel, check-ins & session metrics across full CSV history.';

        const analyzeRes = await fetch('/analyze-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId }),
        });

        const analyzeData = await analyzeRes.json();
        if (!analyzeRes.ok || analyzeData.error) {
          throw new Error(analyzeData.error || 'Analysis failed.');
        }

        loadingBarFill.style.width = '100%';
        window.location.href = analyzeData.redirectUrl || `/select?sessionId=${sessionId}`;
      } catch (err) {
        overlay.hidden = true;
        submitBtn.disabled = false;
        errorBox.textContent = 'Error: ' + err.message;
        errorBox.style.display = 'block';
      }
    });
  </script>
</body>
</html>
