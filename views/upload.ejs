<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Studio Performance Reports</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+Pro:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="upload-page">
  <div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <main class="container upload-shell">
    <div class="upload-hero">
      <span class="eyebrow">Studio Pulse</span>
      <h1>Performance Report <span class="accent">Generator</span></h1>
      <p class="subtitle">Drop all your CSV files at once into the common upload section below. Files will be automatically identified by keyword!</p>
      
      <div class="upload-actions">
        <button type="button" class="btn btn-primary" id="load-july-reports">Load July 2026 Reports</button>
      </div>

      <div style="margin-top:12px; display:flex; gap:8px; justify-content:center; align-items:center;">
        <input type="text" id="join-code" placeholder="6-digit code" maxlength="6" style="padding:10px; border-radius:8px; border:1px solid var(--border); background:var(--bg-card); color:var(--text); font-family:var(--font-mono); font-size:16px; text-align:center; width:140px; letter-spacing:2px;" />
        <button type="button" class="btn btn-secondary" onclick="const code = document.getElementById('join-code').value.trim(); if(code.length === 6) window.location.href = '/join/' + code;">Join Session</button>
      </div>
    </div>

    <% if (error) { %>
      <div class="error" id="error-box" role="alert"><%= error %></div>
    <% } else { %>
      <div class="error" id="error-box" role="alert" style="display:none;"></div>
    <% } %>

    <!-- Saved Upload Sessions Section -->
    <div id="saved-sessions-wrapper" style="display:none; margin-bottom: 32px;">
      <div class="slots-header" style="margin-bottom: 12px;">
        <span>📂 Previous Upload Sessions (Persisted)</span>
        <span class="slots-subtitle">Click any session to reload report options without re-uploading</span>
      </div>
      <div id="saved-sessions-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px;"></div>
    </div>

    <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data" novalidate>
      <div class="master-dropzone" id="master-dropzone" tabindex="0">
        <div class="master-dz-icon">📂</div>
        <div class="master-dz-body">
          <div class="master-dz-title">Drop all CSV files here</div>
          <div class="master-dz-sub">Select multiple CSV files at once — we'll automatically identify Sales, Sessions, Checkins, Leads, New/Trials, Lapsed &amp; Active based on keywords in the filenames.</div>
          <div class="master-dz-badge" id="master-dz-status">Click or drag &amp; drop CSV files</div>
        </div>
        <input type="file" id="master-file-input" multiple accept=".csv" />
      </div>

      <div class="slots-header">
        <span>Detected &amp; Assigned CSV Slots</span>
        <span class="slots-subtitle">Drag or pick individual files below if needed</span>
      </div>

      <div class="dropzones" id="dropzones">
        <% const icons = { sales: '💳', sessions: '🗓️', checkins: '✅', leads: '📞', new: '✨', lapsed: '📉', active: '👥' };
           slots.forEach(function(slot, i) { %>
          <label class="dropzone" data-field="<%= slot.field %>" style="--i: <%= i %>" tabindex="0">
            <div class="dz-icon"><%= icons[slot.field] || '📄' %></div>
            <div class="dz-body">
              <span class="dz-label"><%= slot.label %></span>
              <span class="dz-file">CSV file &middot; drag or click</span>
            </div>
            <div class="dz-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <input type="file" name="<%= slot.field %>" accept=".csv" required />
          </label>
        <% }) %>
      </div>

      <button type="submit" id="submit-btn" class="btn btn-primary" disabled>
        <span class="btn-label">Upload &amp; Analyze</span>
        <span class="btn-count"><span id="filled-count">0</span>/<%= slots.length %></span>
      </button>
    </form>
  </main>

  <div id="loading-overlay" class="loading-overlay" hidden>
    <div class="loading-card">
      <div class="spinner"></div>
      <div class="loading-title" id="loading-title">Analyzing your data&hellip;</div>
      <div class="loading-sub" id="loading-sub">Preparing CSVs and detecting studios &amp; months.</div>
      <div class="loading-bar"><div class="loading-bar-fill" id="loading-bar-fill" style="width: 0%;"></div></div>
    </div>
  </div>

  <div class="july-reports-viewer is-single" id="july-reports-viewer" aria-hidden="true">
    <div class="july-view-switcher" id="july-view-switcher">
      <button class="july-switcher-toggle" id="july-switcher-toggle" type="button" aria-label="Switch report view" aria-expanded="false">⇄</button>
      <div class="july-viewer-tabs" aria-label="Report viewer mode">
        <button class="july-tab is-active" type="button" data-report-mode="kwality">Kemps</button>
        <button class="july-tab" type="button" data-report-mode="supreme">Bandra</button>
        <button class="july-tab" type="button" data-report-mode="split">Both</button>
      </div>
    </div>
    <button class="july-viewer-close" type="button" id="viewer-close" aria-label="Close July reports">Close</button>
    <div class="july-viewer-grid">
      <div class="july-frame-panel is-visible" data-report-panel="kwality">
        <div class="july-frame-label">Kemps Corner &middot; Kwality House</div>
        <iframe class="july-report-frame" id="kwality-report-frame" title="Kemps Corner July 2026 Report"></iframe>
      </div>
      <div class="july-frame-panel" data-report-panel="supreme">
        <div class="july-frame-label">Bandra &middot; Supreme HQ</div>
        <iframe class="july-report-frame" id="supreme-report-frame" title="Bandra July 2026 Report"></iframe>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('upload-form');
    const submitBtn = document.getElementById('submit-btn');
    const filledCountEl = document.getElementById('filled-count');
    const dropzones = Array.from(document.querySelectorAll('.dropzone'));
    const errorBox = document.getElementById('error-box');
    const overlay = document.getElementById('loading-overlay');
    const loadingTitle = document.getElementById('loading-title');
    const loadingSub = document.getElementById('loading-sub');
    const loadingBarFill = document.getElementById('loading-bar-fill');
    const total = dropzones.length;

    const masterZone = document.getElementById('master-dropzone');
    const masterInput = document.getElementById('master-file-input');
    const masterStatus = document.getElementById('master-dz-status');

    const KEYWORD_MAP = {
      sales: ['sale', 'sales', 'revenue', 'transaction', 'invoice', 'billing', 'payment', 'gross', 'net'],
      sessions: ['session', 'sessions', 'class', 'classes', 'booking', 'schedule', 'format', 'trainer'],
      checkins: ['checkin', 'checkins', 'check-in', 'check_in', 'visit', 'attendance'],
      leads: ['lead', 'leads', 'inquir', 'prospect', 'acquisition'],
      new: ['new', 'trial', 'trials', 'first_time', 'first-time', 'join', 'joined', 'conversion'],
      lapsed: ['lapsed', 'lapse', 'churn', 'cancell', 'expire', 'renew', 'renewal'],
      active: ['active', 'member', 'members', 'subscription', 'base']
    };

    const julyReportSources = {
      kwality: '/revised-july/kwality-house-july-2026.html?v=4',
      supreme: '/revised-july/supreme-hq-bandra-july-2026.html?v=4'
    };
    const julyViewer = document.getElementById('july-reports-viewer');
    const julyLoadBtn = document.getElementById('load-july-reports');
    const julyCloseBtn = document.getElementById('viewer-close');
    const julySwitcher = document.getElementById('july-view-switcher');
    const julySwitcherToggle = document.getElementById('july-switcher-toggle');
    const kwalityReportFrame = document.getElementById('kwality-report-frame');
    const supremeReportFrame = document.getElementById('supreme-report-frame');
    const julyTabs = Array.from(document.querySelectorAll('[data-report-mode]'));
    const julyPanels = Array.from(document.querySelectorAll('[data-report-panel]'));
    let julyReportsLoaded = false;
    let julySwitcherTimer = null;

    julyLoadBtn.addEventListener('click', () => {
      if (!julyReportsLoaded) {
        kwalityReportFrame.src = julyReportSources.kwality;
        supremeReportFrame.src = julyReportSources.supreme;
        julyReportsLoaded = true;
      }
      julyViewer.classList.add('is-open');
      julyViewer.setAttribute('aria-hidden', 'false');
      setJulyReportMode('kwality');
      collapseJulySwitcher();
    });
    julyCloseBtn.addEventListener('click', closeJulyViewer);
    julySwitcherToggle.addEventListener('click', () => {
      julySwitcher.classList.toggle('is-expanded');
      julySwitcherToggle.setAttribute('aria-expanded', julySwitcher.classList.contains('is-expanded') ? 'true' : 'false');
      scheduleJulySwitcherCollapse();
    });
    julyTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setJulyReportMode(tab.dataset.reportMode);
        scheduleJulySwitcherCollapse();
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && julyViewer.classList.contains('is-open')) closeJulyViewer();
    });

    function closeJulyViewer() {
      julyViewer.classList.remove('is-open');
      julyViewer.setAttribute('aria-hidden', 'true');
      collapseJulySwitcher();
    }

    function collapseJulySwitcher() {
      window.clearTimeout(julySwitcherTimer);
      julySwitcher.classList.remove('is-expanded');
      julySwitcherToggle.setAttribute('aria-expanded', 'false');
    }

    function scheduleJulySwitcherCollapse() {
      window.clearTimeout(julySwitcherTimer);
      julySwitcherTimer = window.setTimeout(collapseJulySwitcher, 3200);
    }

    function setJulyReportMode(mode) {
      const normalizedMode = mode === 'supreme' || mode === 'split' ? mode : 'kwality';
      julyViewer.classList.toggle('is-split', normalizedMode === 'split');
      julyViewer.classList.toggle('is-single', normalizedMode !== 'split');
      julyTabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.reportMode === normalizedMode));
      julyPanels.forEach((panel) => {
        const visible = normalizedMode === 'split' || panel.dataset.reportPanel === normalizedMode;
        panel.classList.toggle('is-visible', visible);
      });
    }

    function matchFileToSlot(fileName) {
      const cleanName = fileName.toLowerCase().replace(/[^a-z0-9]/g, '_');
      let bestSlot = null;
      let highestScore = 0;

      for (const [slot, keywords] of Object.entries(KEYWORD_MAP)) {
        for (const kw of keywords) {
          if (cleanName.includes(kw)) {
            const score = kw.length;
            if (score > highestScore) {
              highestScore = score;
              bestSlot = slot;
            }
          }
        }
      }
      return bestSlot;
    }

    function processBatchFiles(files) {
      const fileArray = Array.from(files);
      let matchedCount = 0;

      fileArray.forEach((file) => {
        const slotName = matchFileToSlot(file.name);
        if (slotName) {
          const zone = dropzones.find((z) => z.dataset.field === slotName);
          if (zone) {
            const input = zone.querySelector('input[type=file]');
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            updateZone(zone);
            matchedCount++;
          }
        }
      });

      refreshMasterStatus();
    }

    function refreshMasterStatus() {
      const filled = dropzones.filter((z) => z.classList.contains('filled')).length;
      if (filled === total) {
        masterStatus.textContent = '🎉 All 7 required CSV slots auto-matched!';
        masterStatus.classList.add('all-matched');
      } else if (filled > 0) {
        masterStatus.textContent = `✓ ${filled} of 7 slots assigned. Please drop or pick missing files below.`;
        masterStatus.classList.remove('all-matched');
      } else {
        masterStatus.textContent = 'Click or drag & drop CSV files';
        masterStatus.classList.remove('all-matched');
      }
    }

    masterInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files.length > 0) {
        processBatchFiles(e.target.files);
      }
    });

    ['dragenter', 'dragover'].forEach((evt) =>
      masterZone.addEventListener(evt, (e) => {
        e.preventDefault();
        masterZone.classList.add('drag-over');
      })
    );
    ['dragleave', 'dragend', 'drop'].forEach((evt) =>
      masterZone.addEventListener(evt, (e) => {
        e.preventDefault();
        masterZone.classList.remove('drag-over');
      })
    );
    masterZone.addEventListener('drop', (e) => {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        processBatchFiles(e.dataTransfer.files);
      }
    });

    function truncate(name, max) {
      if (name.length <= max) return name;
      return name.slice(0, max - 1) + '…';
    }

    function updateZone(zone) {
      const input = zone.querySelector('input[type=file]');
      const fileEl = zone.querySelector('.dz-file');
      if (input.files && input.files[0]) {
        zone.classList.add('filled');
        fileEl.textContent = truncate(input.files[0].name, 28);
      } else {
        zone.classList.remove('filled');
        fileEl.textContent = 'CSV file · drag or click';
      }
      refreshCount();
    }

    function refreshCount() {
      const filled = dropzones.filter((z) => z.classList.contains('filled')).length;
      filledCountEl.textContent = filled;
      submitBtn.disabled = filled < total;
      refreshMasterStatus();
    }

    dropzones.forEach((zone) => {
      const input = zone.querySelector('input[type=file]');
      input.addEventListener('change', () => updateZone(zone));

      zone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
      });

      ['dragenter', 'dragover'].forEach((evt) =>
        zone.addEventListener(evt, (e) => {
          e.preventDefault();
          zone.classList.add('drag-over');
        })
      );
      ['dragleave', 'dragend', 'drop'].forEach((evt) =>
        zone.addEventListener(evt, (e) => {
          e.preventDefault();
          zone.classList.remove('drag-over');
        })
      );
      zone.addEventListener('drop', (e) => {
        const file = e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) {
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          updateZone(zone);
        }
      });
    });

    async function uploadFileInChunks(sessionId, slotField, file, onProgress) {
      const CHUNK_SIZE = 1.5 * 1024 * 1024; // 1.5 MB chunk size to stay safely under Vercel's 4.5 MB limit
      const totalChunks = Math.ceil(file.size / CHUNK_SIZE);

      for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
        const start = chunkIndex * CHUNK_SIZE;
        const end = Math.min(file.size, start + CHUNK_SIZE);
        const blobChunk = file.slice(start, end);

        const formData = new FormData();
        formData.append('sessionId', sessionId);
        formData.append('slot', slotField);
        formData.append('chunkIndex', chunkIndex);
        formData.append('totalChunks', totalChunks);
        formData.append('chunk', blobChunk, `${slotField}_part_${chunkIndex}.csv`);

        const res = await fetch('/upload-chunk', {
          method: 'POST',
          body: formData,
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Upload failed for ${slotField} (part ${chunkIndex + 1}/${totalChunks})`);
        }

        if (onProgress) {
          onProgress(chunkIndex + 1, totalChunks);
        }
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      overlay.hidden = false;
      errorBox.style.display = 'none';

      const sessionId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : 'session_' + Date.now();

      try {
        for (let i = 0; i < dropzones.length; i++) {
          const zone = dropzones[i];
          const field = zone.dataset.field;
          const input = zone.querySelector('input[type=file]');
          const rawFile = input.files[0];

          await uploadFileInChunks(sessionId, field, rawFile, (chunkIdx, totalChunks) => {
            const filePct = chunkIdx / totalChunks;
            const overallPct = Math.round(((i + filePct) / (dropzones.length + 1)) * 100);
            loadingBarFill.style.width = overallPct + '%';
            loadingTitle.textContent = `Uploading file ${i + 1} of ${dropzones.length}: ${truncate(rawFile.name, 22)}`;
            loadingSub.textContent = `Uploading chunk ${chunkIdx} of ${totalChunks} (${(rawFile.size / (1024 * 1024)).toFixed(1)} MB total full file).`;
          });
        }

        loadingBarFill.style.width = '90%';
        loadingTitle.textContent = 'Running performance analysis on full dataset…';
        loadingSub.textContent = 'Aggregating revenue, conversion funnel, check-ins & session metrics across full CSV history.';

        const analyzeRes = await fetch('/analyze-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId }),
        });

        const analyzeData = await analyzeRes.json();
        if (!analyzeRes.ok || analyzeData.error) {
          throw new Error(analyzeData.error || 'Analysis failed.');
        }

        loadingBarFill.style.width = '100%';
        window.location.href = analyzeData.redirectUrl || `/select?sessionId=${sessionId}`;
      } catch (err) {
        overlay.hidden = true;
        submitBtn.disabled = false;
        errorBox.textContent = 'Error: ' + err.message;
        errorBox.style.display = 'block';
      }
    });

    // Fetch persistent saved sessions on load
    (async function checkSavedSessions() {
      try {
        const res = await fetch('/api/saved-sessions');
        const data = await res.json();
        const validSessions = (data.sessions || []).filter(s => s && s.sessionId && s.sessionId !== 'undefined');
        if (validSessions.length > 0) {
          const wrapper = document.getElementById('saved-sessions-wrapper');
          const grid = document.getElementById('saved-sessions-grid');
          wrapper.style.display = 'block';
          grid.innerHTML = validSessions.map(s => {
            const locs = (s.locNames && s.locNames.length > 0) ? s.locNames.join(', ') : 'Studio Session';
            const months = (s.months && s.months.length > 0) ? `${s.months[s.months.length-1]} to ${s.months[0]}` : 'Multi-month';
            const dateStr = s.created ? new Date(s.created).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
            return `
              <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
                <div>
                  <div style="font-weight: 700; color: var(--text); font-size: 15px;">🏢 ${locs}</div>
                  <div style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">🗓️ ${months} &middot; ${dateStr}</div>
                </div>
                <button type="button" class="btn btn-secondary" style="font-size: 13px; padding: 6px 12px; align-self: flex-start; margin-top: 4px;" onclick="window.location.href='/select?sessionId=${encodeURIComponent(s.sessionId)}'">
                  Reload Session &rarr;
                </button>
              </div>`;
          }).join('');
        }
      } catch (e) {}
    })();
  </script>
  <script src="/revised-july/sfx-soundboard.js?v=4"></script>
</body>
</html>
